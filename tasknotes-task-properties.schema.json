{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasknotes.dev/schemas/task-properties-settings.schema.json",
  "title": "TaskNotes Task Properties Settings",
  "type": "object",
  "description": "Configuration model for TaskNotes 'Settings -> Task Properties'.",
  "$comment": "This schema is derived from https://tasknotes.dev/settings/task-properties/ (documentation page), not from a published canonical machine schema. Some field names are inferred and can be adjusted to match your internal config keys.",
  "additionalProperties": false,
  "required": [
    "title",
    "status",
    "priority",
    "dueDate",
    "scheduledDate",
    "contexts",
    "projects",
    "tags",
    "timeEstimate",
    "recurrence",
    "reminders",
    "metadataProperties",
    "featureProperties",
    "customUserFields"
  ],
  "properties": {
    "title": {
      "type": "object",
      "description": "Settings for the task title property and filename behavior.",
      "$comment": "Docs: Property key, Store title in filename, Filename format, Custom template.",
      "additionalProperties": false,
      "required": ["propertyKey", "storeTitleInFilename", "filenameFormat"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "title",
          "description": "Frontmatter key for title when title is stored in frontmatter."
        },
        "storeTitleInFilename": {
          "type": "boolean",
          "default": false,
          "description": "When true, title is persisted in filename instead of frontmatter."
        },
        "filenameFormat": {
          "type": "string",
          "enum": [
            "title-based",
            "zettelkasten-style",
            "timestamp-based",
            "uuid-v4",
            "custom-template"
          ],
          "default": "title-based",
          "description": "Filename generation mode used when appropriate."
        },
        "customTemplate": {
          "type": "string",
          "minLength": 1,
          "description": "Filename template string; typically used with custom-template format."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "filenameFormat": { "const": "custom-template" } },
            "required": ["filenameFormat"]
          },
          "then": {
            "required": ["customTemplate"]
          }
        }
      ]
    },
    "status": {
      "type": "object",
      "description": "Task completion state settings.",
      "$comment": "Docs include NLP trigger, default, list of status cards, and per-status options.",
      "additionalProperties": false,
      "required": ["propertyKey", "nlpTrigger", "values"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "status"
        },
        "defaultValue": {
          "$ref": "#/$defs/statusValueRef",
          "description": "Default status for new tasks."
        },
        "nlpTrigger": {
          "$ref": "#/$defs/nlpTrigger",
          "default": { "enabled": true, "character": "*" }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered status cards; order drives cycle behavior unless overridden.",
          "items": { "$ref": "#/$defs/statusValue" }
        }
      }
    },
    "priority": {
      "type": "object",
      "description": "Task priority settings.",
      "additionalProperties": false,
      "required": ["propertyKey", "nlpTrigger", "values"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "priority"
        },
        "defaultValue": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
          "description": "Default priority value; null means 'No default'."
        },
        "nlpTrigger": {
          "$ref": "#/$defs/nlpTrigger",
          "default": { "enabled": false, "character": "!" }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered priority cards.",
          "items": { "$ref": "#/$defs/priorityValue" }
        }
      }
    },
    "dueDate": {
      "$ref": "#/$defs/datePropertyConfig",
      "description": "Due date property settings.",
      "$comment": "Default key in docs: due."
    },
    "scheduledDate": {
      "$ref": "#/$defs/datePropertyConfig",
      "description": "Scheduled date property settings.",
      "$comment": "Default key in docs: scheduled."
    },
    "contexts": {
      "type": "object",
      "description": "Context labels (e.g. @home, @work).",
      "additionalProperties": false,
      "required": ["propertyKey", "defaultValues", "nlpTrigger"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "contexts"
        },
        "defaultValues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "Default contexts; UI may collect these as comma-separated input."
        },
        "nlpTrigger": {
          "$ref": "#/$defs/nlpTrigger",
          "default": { "enabled": true, "character": "@" }
        }
      }
    },
    "projects": {
      "type": "object",
      "description": "Project linking and project autosuggest configuration.",
      "additionalProperties": false,
      "required": [
        "propertyKey",
        "defaultProjects",
        "useActiveNoteForNewTasks",
        "useParentNoteForInlineOrInstantConversion",
        "nlpTrigger",
        "autosuggestFilters",
        "customizeDisplay"
      ],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "projects"
        },
        "defaultProjects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "List of notes/projects to auto-link on new task creation."
        },
        "useActiveNoteForNewTasks": {
          "type": "boolean",
          "default": false
        },
        "useParentNoteForInlineOrInstantConversion": {
          "type": "boolean",
          "default": false
        },
        "nlpTrigger": {
          "$ref": "#/$defs/nlpTrigger",
          "default": { "enabled": true, "character": "+" }
        },
        "autosuggestFilters": {
          "$ref": "#/$defs/autosuggestFilters"
        },
        "customizeDisplay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enableFuzzyMatching", "rows"],
          "properties": {
            "enableFuzzyMatching": { "type": "boolean", "default": true },
            "rows": {
              "type": "array",
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1 },
              "default": [],
              "description": "Up to 3 display row expressions/fields for suggestion rendering."
            }
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "description": "Native Obsidian tags settings (no dedicated property key in docs).",
      "additionalProperties": false,
      "required": ["defaultValues", "nlpTrigger"],
      "properties": {
        "defaultValues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^#].*$" },
          "default": [],
          "description": "Default tags without '#'."
        },
        "nlpTrigger": {
          "$ref": "#/$defs/nlpTrigger",
          "default": { "enabled": true, "character": "#" }
        }
      }
    },
    "timeEstimate": {
      "type": "object",
      "description": "Estimated minutes to complete task.",
      "additionalProperties": false,
      "required": ["propertyKey", "defaultMinutes"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "timeEstimate"
        },
        "defaultMinutes": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "0 means 'no default'."
        }
      }
    },
    "recurrence": {
      "type": "object",
      "description": "Recurring pattern property settings.",
      "additionalProperties": false,
      "required": ["propertyKey", "defaultPattern"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "recurrence"
        },
        "defaultPattern": {
          "type": "string",
          "enum": ["none", "daily", "weekly", "monthly", "yearly"],
          "default": "none"
        }
      }
    },
    "reminders": {
      "type": "object",
      "description": "Reminder property and default reminders.",
      "additionalProperties": false,
      "required": ["propertyKey", "defaultReminders"],
      "properties": {
        "propertyKey": {
          "$ref": "#/$defs/propertyKey",
          "default": "reminders"
        },
        "defaultReminders": {
          "type": "array",
          "items": { "$ref": "#/$defs/reminder" },
          "default": []
        }
      }
    },
    "metadataProperties": {
      "type": "object",
      "description": "System-managed metadata frontmatter keys.",
      "$comment": "Docs say these are typically only key-configurable and system-managed.",
      "additionalProperties": false,
      "required": [
        "dateCreated",
        "dateModified",
        "completedDate",
        "archiveTag",
        "timeEntries",
        "completeInstances",
        "skippedInstances",
        "recurrenceAnchor",
        "blockedBy"
      ],
      "properties": {
        "dateCreated": { "$ref": "#/$defs/propertyKeyOnly" },
        "dateModified": { "$ref": "#/$defs/propertyKeyOnly" },
        "completedDate": { "$ref": "#/$defs/propertyKeyOnly" },
        "archiveTag": { "$ref": "#/$defs/propertyKeyOnly" },
        "timeEntries": { "$ref": "#/$defs/propertyKeyOnly" },
        "completeInstances": { "$ref": "#/$defs/propertyKeyOnly" },
        "skippedInstances": { "$ref": "#/$defs/propertyKeyOnly" },
        "recurrenceAnchor": { "$ref": "#/$defs/propertyKeyOnly" },
        "blockedBy": { "$ref": "#/$defs/propertyKeyOnly" }
      }
    },
    "featureProperties": {
      "type": "object",
      "description": "Keys used by specific features (not standard task frontmatter fields).",
      "additionalProperties": false,
      "required": ["pomodoros", "icsEventId", "icsEventTag"],
      "properties": {
        "pomodoros": { "$ref": "#/$defs/propertyKeyOnly" },
        "icsEventId": { "$ref": "#/$defs/propertyKeyOnly" },
        "icsEventTag": { "$ref": "#/$defs/propertyKeyOnly" }
      }
    },
    "customUserFields": {
      "type": "array",
      "description": "User-defined frontmatter fields visible in TaskNotes filtering and views.",
      "default": [],
      "items": { "$ref": "#/$defs/customUserField" }
    }
  },
  "$defs": {
    "propertyKey": {
      "type": "string",
      "minLength": 1,
      "description": "YAML/frontmatter property key.",
      "$comment": "Docs note keys with spaces/punctuation are allowed, but may require bracket notation in formulas."
    },
    "propertyKeyOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyKey"],
      "properties": {
        "propertyKey": { "$ref": "#/$defs/propertyKey" }
      }
    },
    "nlpTrigger": {
      "type": "object",
      "description": "Natural language parsing trigger config.",
      "additionalProperties": false,
      "required": ["enabled", "character"],
      "properties": {
        "enabled": { "type": "boolean" },
        "character": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "Single-character trigger symbol."
        }
      }
    },
    "autosuggestFilters": {
      "type": "object",
      "description": "Filter controls for note/file suggestions.",
      "additionalProperties": false,
      "required": [
        "requiredTags",
        "includeFolders",
        "requiredPropertyKey",
        "requiredPropertyValue"
      ],
      "properties": {
        "requiredTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "ANY-match semantics."
        },
        "includeFolders": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "ANY-match semantics."
        },
        "requiredPropertyKey": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
          "default": null
        },
        "requiredPropertyValue": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ],
          "default": null
        }
      }
    },
    "dateDefaultPreset": {
      "type": "string",
      "enum": ["none", "today", "tomorrow", "next-week"]
    },
    "datePropertyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyKey", "defaultPreset"],
      "properties": {
        "propertyKey": { "$ref": "#/$defs/propertyKey" },
        "defaultPreset": { "$ref": "#/$defs/dateDefaultPreset" }
      }
    },
    "statusValueRef": {
      "description": "Stored status identifier can be a string or boolean-like value.",
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "boolean" }
      ]
    },
    "statusValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "color", "completed", "skipWhenCycling"],
      "properties": {
        "value": {
          "$ref": "#/$defs/statusValueRef",
          "description": "Internal stored value. Can support boolean compatibility."
        },
        "label": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "minLength": 1 },
        "icon": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
          "default": null
        },
        "completed": { "type": "boolean" },
        "skipWhenCycling": { "type": "boolean" },
        "nextStatus": {
          "anyOf": [{ "$ref": "#/$defs/statusValueRef" }, { "type": "null" }],
          "default": null
        },
        "autoArchiveMinutes": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 1440 },
            { "type": "null" }
          ],
          "default": null
        }
      }
    },
    "priorityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "color"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "minLength": 1 }
      }
    },
    "relativeReminder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "anchor", "offsetAmount", "offsetUnit", "direction"],
      "properties": {
        "kind": { "const": "relative" },
        "anchor": { "type": "string", "enum": ["due-date", "scheduled-date"] },
        "offsetAmount": { "type": "integer", "minimum": 0 },
        "offsetUnit": { "type": "string", "enum": ["minutes", "hours", "days"] },
        "direction": { "type": "string", "enum": ["before", "after"] },
        "description": { "type": "string" }
      }
    },
    "absoluteReminder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "date", "time"],
      "properties": {
        "kind": { "const": "absolute" },
        "date": {
          "type": "string",
          "format": "date",
          "description": "ISO date (YYYY-MM-DD)."
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
          "description": "24-hour local HH:MM."
        },
        "description": { "type": "string" }
      }
    },
    "reminder": {
      "oneOf": [
        { "$ref": "#/$defs/relativeReminder" },
        { "$ref": "#/$defs/absoluteReminder" }
      ]
    },
    "customUserField": {
      "type": "object",
      "description": "Custom user field definition.",
      "additionalProperties": false,
      "required": [
        "displayName",
        "propertyKey",
        "type",
        "defaultValue",
        "nlpTrigger",
        "autosuggestFilters"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "propertyKey": { "$ref": "#/$defs/propertyKey" },
        "type": {
          "type": "string",
          "enum": ["text", "number", "boolean", "date", "list"]
        },
        "defaultValue": {
          "description": "Type-specific default value.",
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "$ref": "#/$defs/dateDefaultPreset" },
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            { "type": "null" }
          ]
        },
        "nlpTrigger": { "$ref": "#/$defs/nlpTrigger" },
        "autosuggestFilters": { "$ref": "#/$defs/autosuggestFilters" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "properties": { "defaultValue": { "anyOf": [{ "type": "string" }, { "type": "null" }] } } }
        },
        {
          "if": { "properties": { "type": { "const": "number" } }, "required": ["type"] },
          "then": { "properties": { "defaultValue": { "anyOf": [{ "type": "number" }, { "type": "null" }] } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "defaultValue": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] } } }
        },
        {
          "if": { "properties": { "type": { "const": "date" } }, "required": ["type"] },
          "then": { "properties": { "defaultValue": { "anyOf": [{ "$ref": "#/$defs/dateDefaultPreset" }, { "type": "null" }] } } }
        },
        {
          "if": { "properties": { "type": { "const": "list" } }, "required": ["type"] },
          "then": { "properties": { "defaultValue": { "anyOf": [{ "type": "array", "items": { "type": "string", "minLength": 1 } }, { "type": "null" }] } } }
        }
      ]
    }
  }
}

