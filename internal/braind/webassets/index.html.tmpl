<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.ProductName}}: {{.Tagline}}</title>
  <link rel="stylesheet" href="/static/pico.min.css">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <main id="main" class="container">
    <hgroup>
      <h1>{{.ProductName}}</h1>
      <p class="tagline">{{.Tagline}}</p>
    </hgroup>
    <p class="description">{{.Description}}</p>
    <article aria-labelledby="status-heading">
      <h2 id="status-heading">Status</h2>
      <p>{{.ConstructionNotice}}</p>
    </article>
    <article aria-labelledby="books-heading">
      <h2 id="books-heading">Books</h2>
      <p>The reading record: every reviewed book with its cover, rating, and review, newest first.</p>
      <p><a href="/books">Browse the shelf</a></p>
    </article>
  </main>
  <script src="/static/htmx.min.js"></script>
</body>
</html>
