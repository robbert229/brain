<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .Edit}}Edit review{{else}}Add a review{{end}} · {{.ProductName}}</title>
  <link rel="stylesheet" href="/static/pico.min.css">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <main id="main" class="container">
    <hgroup>
      <h1>{{if .Edit}}Edit review{{else}}Add a review{{end}}</h1>
      <p class="tagline">one new note, filed in your vault's Books folder</p>
    </hgroup>
    {{if .Errors}}
    <article aria-label="Form problems">
      <h2>Check the form</h2>
      <ul>
        {{range .Errors}}<li>{{.}}</li>{{end}}
      </ul>
    </article>
    {{end}}
    <form method="post" action="{{if .Edit}}/books/edit{{else}}/books{{end}}">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      {{if .Edit}}<input type="hidden" name="file" value="{{.File}}">{{end}}
      <label for="review-title">Title (required)
        <input id="review-title" name="title" maxlength="200" required value="{{.Values.Title}}">
      </label>
      <label for="review-author">Author
        <input id="review-author" name="author" maxlength="200" value="{{.Values.Author}}">
      </label>
      <label for="review-rating">Rating
        <input id="review-rating" name="rating" placeholder="4.5/5" value="{{.Values.Rating}}">
      </label>
      <label for="review-cover">Cover filename (an attachment in the vault)
        <input id="review-cover" name="cover" placeholder="book-cover-example.jpg" value="{{.Values.Cover}}">
      </label>
      <label for="review-finished">Finished (YYYY-MM-DD)
        <input id="review-finished" name="finished" placeholder="2026-10-01" value="{{.Values.Finished}}">
      </label>
      <label for="review-body">Review (required)
        <textarea id="review-body" name="review" rows="8" required>{{.Values.Review}}</textarea>
      </label>
      <button type="submit">{{if .Edit}}Save changes{{else}}Save review{{end}}</button>
    </form>
    <p><a href="/books">Back to the shelf</a></p>
  </main>
</body>
</html>
